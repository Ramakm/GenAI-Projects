# Copy this file to .env and adjust values as needed
# cp .env.example .env

# LLM Model (must be pulled via: make pull-model)
OLLAMA_MODEL=llama3.2

# Embedding model (downloaded automatically on first build)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Document chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
TOP_K=5

# LLM generation
LLM_TEMPERATURE=0.1

# Upload size limit in MB
MAX_UPLOAD_MB=50
